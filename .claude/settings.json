{
  "permissions": {
    "allow": [
      "mcp__*__apply_migration",
      "mcp__*__execute_sql",
      "mcp__*__list_migrations",
      "mcp__*__get_advisors",
      "mcp__*__list_tables",
      "mcp__*__list_projects",
      "mcp__*__get_project",
      "mcp__*__get_project_url",
      "mcp__*__get_logs"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "d=\"${CLAUDE_PROJECT_DIR:-.}\"; jq -Rs '{hookSpecificOutput:{hookEventName:\"SessionStart\",additionalContext:.}}' < \"$d/.claude/session-rules.md\" 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Loading project rules"
          }
        ]
      }
    ]
  }
}
